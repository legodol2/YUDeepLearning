        "#넘파이로 AND 연산 구현 (그냥 가중치 있는 버전 편향값 없음)\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "def And_Gate(x):\n",
        "  W = np.array([.5,.5])\n",
        "  threshold = .8\n",
        "  sigma = np.sum(x * W)\n",
        "  if sigma >= threshold:\n",
        "    return 1\n",
        "  else:\n",
        "    return 0\n",
        "\n",
        "print('And 논리연산 ')\n",
        "inputs = np.array([[0,0], [0,1], [1,0],[1,1]])\n",
        "for t in inputs:\n",
        "  print(t, \":\", And_Gate(t))"
